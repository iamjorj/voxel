<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the real Mac audio path on real Core Audio devices, with BlackHole standing in for a
       microphone on machines that have none (GitHub's). BlackHole is only used by this test and
       is never shipped. See .github/workflows/mac-live-test.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceChanger.Mac\VoiceChanger.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Voxel\Assets\ai\meanvc\**" Link="Assets\ai\meanvc\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\VoiceChanger.EngineTest\speech.wav" Link="speech.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
