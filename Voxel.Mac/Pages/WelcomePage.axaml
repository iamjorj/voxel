<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Voxel.Mac"
             x:Class="Voxel.Mac.Pages.WelcomePage">
    <StackPanel VerticalAlignment="Center" Margin="40,0,40,44">
        <Border Width="84" Height="84" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
            <app:LogoMark Width="36" Height="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock Classes="title" Text="Welcome to Voxel" TextAlignment="Center" Margin="0,28,0,10" />
        <TextBlock Classes="body" TextAlignment="Center"
                   Text="Pick a voice and every app hears it. Games, Discord, Telegram, calls — no settings to change." />

        <Button Classes="primary" Content="Get started" HorizontalAlignment="Center" Margin="0,36,0,0" Click="GetStarted_Click" />
    </StackPanel>
</UserControl>
