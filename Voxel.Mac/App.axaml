<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Voxel.Mac.App"
             Name="Voxel"
             RequestedThemeVariant="Dark">
    <!-- The Mac menu bar's app menu; without this it offers "About Avalonia". -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Voxel" Click="About_Click" />
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Voxel/Theme.axaml" />
    </Application.Styles>
</Application>
