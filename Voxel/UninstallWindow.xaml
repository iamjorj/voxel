<Window x:Class="Voxel.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Voxel"
        Title="Uninstall Voxel" Width="460" Height="480" Icon="Assets/voxel.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <local:LogoMark Width="14" Height="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="Voxel" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="44,0,44,44">
            <Border Width="84" Height="84" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                <local:LogoMark Width="36" Height="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="Heading" Style="{StaticResource Title}" Text="Uninstall Voxel?" TextAlignment="Center" Margin="0,28,0,10" />
            <TextBlock x:Name="Message" Style="{StaticResource Body}" TextAlignment="Center"
                       Text="Voxel and its settings will be removed, and your real microphone stays the default." />

            <StackPanel x:Name="AskPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Uninstall" Click="Uninstall_Click" />
                <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="12,0,0,0" Click="Close_Click" />
            </StackPanel>
            <Button x:Name="DoneButton" Style="{StaticResource GhostButton}" Content="Close" HorizontalAlignment="Center" Margin="0,32,0,0"
                    Click="Close_Click" Visibility="Collapsed" />
            <TextBlock x:Name="Note" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,22,0,0"
                       Text="The VB-CABLE virtual mic stays installed. Remove it in Windows Settings → Apps if you don't need it." />
        </StackPanel>
    </Grid>
</Window>
