<Window x:Class="Voxel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Voxel"
        Title="Voxel" Width="780" Height="720" Icon="Assets/voxel.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Custom title bar: the whole top strip drags the window, except the buttons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <local:LogoMark Width="14" Height="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="Voxel" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,8,0" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="12,0" Height="26" Margin="0,3,8,3" Click="Update_Click" Visibility="Collapsed" />
                <Button x:Name="SettingsButton" Style="{StaticResource WindowButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings" Visibility="Collapsed" />
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <ContentControl x:Name="ContentHost" Grid.Row="1" Focusable="False" />
    </Grid>
</Window>
