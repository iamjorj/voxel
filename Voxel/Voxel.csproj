<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VoiceChanger.Core\VoiceChanger.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Voxel</AssemblyName>
    <RootNamespace>Voxel</RootNamespace>
    <ApplicationIcon>Assets\voxel.ico</ApplicationIcon>
    <Version>0.1.3</Version>
    <Product>Voxel</Product>
    <Description>Free one-click voice changer for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\voxel.ico" />
    <!-- Install locations and uninstall, shared with VoxelSetup -->
    <Compile Include="..\Voxel.Setup\Installation.cs" Link="Installation.cs" />
  </ItemGroup>

  <!-- VB-CABLE driver pack, redistributed under VB-Audio's donationware terms (see SetupPage). -->
  <ItemGroup>
    <None Update="Assets\vbcable\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- AI voice model: MeanVC2 (Apache-2.0), exported to ONNX. -->
    <None Update="Assets\ai\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
