<UserControl x:Class="Voxel.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Voxel mark: five sound bars forming a V. Size it with Width/Height; colour with Foreground. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="72" Height="80">
            <Path Canvas.Left="-24" Canvas.Top="-24"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M30,38 V62 M45,30 V82 M60,46 V98 M75,30 V82 M90,38 V62" />
        </Canvas>
    </Viewbox>
</UserControl>
