<UserControl x:Class="Voxel.LevelBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="24">
    <!-- Five bars that dance with the voice level, echoing the logo. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Rectangle x:Name="B1" Width="4" Height="6" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
        <Rectangle x:Name="B2" Width="4" Height="10" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
        <Rectangle x:Name="B3" Width="4" Height="14" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
        <Rectangle x:Name="B4" Width="4" Height="10" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
        <Rectangle x:Name="B5" Width="4" Height="6" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
    </StackPanel>
</UserControl>
